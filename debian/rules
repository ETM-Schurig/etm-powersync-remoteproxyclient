#!/usr/bin/make -f
# -*- makefile -*-

export DH_VERBOSE=1

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

include /usr/share/dpkg/buildflags.mk

PREPROCESS_FILES := $(wildcard debian/*.in)

$(PREPROCESS_FILES:.in=): %: %.in
	sed 's,/@DEB_HOST_MULTIARCH@,$(DEB_HOST_MULTIARCH:%=/%),g' $< > $@

# One binary package: debhelper would install straight into it. Stage in debian/tmp so that only
# the files of the .install list are shipped (no headers, no pkg-config file).
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

override_dh_install: $(PREPROCESS_FILES:.in=)
	dh_install

# Note that this is the default with compat level 12.
override_dh_missing:
	dh_missing --list-missing

override_dh_auto_clean:
	dh_auto_clean
	rm -rf $(PREPROCESS_FILES:.in=)

# Where etm-powersync-deploy installs the box certificate.
override_dh_auto_configure:
	dh_auto_configure -- BOX_CERTIFICATE_DIR=/etc/etm-powersync/remote-proxy

override_dh_auto_test:
	dh_auto_test -- -k TESTARGS="-maxwarnings 0"

%:
	dh $@ --buildsystem=qmake6 --parallel
